{
  "name": "@cofy-x/dsh-console-trajectory",
  "version": "0.1.0-alpha.0",
  "description": "Optional DSH-native trajectory viewer for DSH Console",
  "type": "module",
  "license": "Apache-2.0",
  "author": "cofy-x contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofy-x/dsh-console-trajectory.git"
  },
  "homepage": "https://github.com/cofy-x/dsh-console-trajectory#readme",
  "bugs": {
    "url": "https://github.com/cofy-x/dsh-console-trajectory/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"import('node:fs/promises').then(({rm}) => rm('dist', {recursive:true,force:true}))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm build && npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.1-rc.2",
    "@shikijs/langs": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.9",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-base": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
